{
  "name": "@vdrsl/opencode-agentpost",
  "version": "0.15.0",
  "description": "Peer-to-peer messaging between opencode agents running in different sessions, directories and servers",
  "keywords": ["opencode", "opencode-plugin", "agent", "multi-agent", "mail", "messaging"],
  "license": "MIT",
  "author": "Vdrsl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vdrsl/opencode-agentpost.git"
  },
  "homepage": "https://github.com/Vdrsl/opencode-agentpost#readme",
  "bugs": {
    "url": "https://github.com/Vdrsl/opencode-agentpost/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --test-concurrency=1 \"test/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
